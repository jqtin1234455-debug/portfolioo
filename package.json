{
  "name": "jatin-yadav-portfolio-web",
  "version": "1.0.0",
  "description": "Premium portfolio website built with React and Vue.js",
  "scripts": {
    "dev:react": "cd react-app && npm run dev",
    "dev:vue": "cd vue-app && npm run dev",
    "dev:next": "npm --prefix next-app run dev",
    "build:react": "cd react-app && npm run build",
    "build:vue": "cd vue-app && npm run build",
    "build:next": "npm --prefix next-app run build",
    "build": "cd react-app && npm run build && cd ../vue-app && npm run build"
  },
  "keywords": [
    "react",
    "vue",
    "mern",
    "fullstack",
    "portfolio",
    "business"
  ],
  "author": "Portfolio Project",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
